# Copy this file to .env and fill in the two values from your Supabase
# project: Supabase dashboard -> Project Settings -> API
#
# Use the SAME project as the ResiFix KNUST mobile app. That shared
# project is what connects the two — a report filed on a phone appears on
# this dashboard because both read the same tables.
#
# Create React App inlines REACT_APP_* variables into the bundle, so only
# the anon key belongs here. It is safe to ship: row level security decides
# what it can reach. NEVER put the service_role key in this file.
#
# CRA reads .env once at startup — restart `npm start` after editing.

REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
